{
  "watch": [
    "src"
  ],
  "ext": ".ts,.js,.json",
  "ignore": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts",
    ".git",
    "src/ai/**/*.py"
  ],
  "exec": "ts-node -r tsconfig-paths/register src/api/server.ts",
  "verbose": true,
  "delay": 1000,
  "env": {
    "NODE_ENV": "development",
    "TS_NODE_PROJECT": "./tsconfig.json"
  }
}