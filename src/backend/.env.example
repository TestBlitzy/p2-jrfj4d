# Application Settings
NODE_ENV=development
PORT=3000
API_VERSION=v1
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Database Configuration
# PostgreSQL v15+
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SSL=false

# Redis v7.0+
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_PREFIX=sip:

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
MFA_ENABLED=true
MFA_ISSUER=Sales & Intelligence Platform
SESSION_SECRET=your_session_secret

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# AI/ML Configuration
AI_USE_GPU=false
LEAD_SCORING_MODEL_PATH=./models/lead-scoring
LEAD_SCORING_MODEL_VERSION=1.0.0
LEAD_SCORING_CONFIDENCE_THRESHOLD=0.8
LEAD_SCORING_BATCH_SIZE=32
LEAD_SCORING_EPOCHS=100

REVENUE_FORECAST_MODEL_PATH=./models/revenue-forecast
REVENUE_FORECAST_MODEL_VERSION=1.0.0

MARKET_INTELLIGENCE_MODEL_PATH=./models/market-intelligence
MARKET_INTELLIGENCE_MODEL_VERSION=1.0.0

BERT_MODEL_VERSION=1.0.0
BERT_MAX_SEQUENCE_LENGTH=512

# Third-Party Integrations
# Salesforce v54.0
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_CALLBACK_URL=http://localhost:3000/api/v1/integrations/salesforce/callback
SALESFORCE_API_VERSION=v54.0

# HubSpot v3
HUBSPOT_API_KEY=your_hubspot_api_key
HUBSPOT_API_VERSION=v3

# Email Services
SENDGRID_API_KEY=your_sendgrid_api_key

GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_CALLBACK_URL=http://localhost:3000/api/v1/integrations/gmail/callback

# LinkedIn Sales Navigator v2
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/v1/integrations/linkedin/callback

# Slack v2
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=your_slack_app_token