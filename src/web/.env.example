# API Configuration
# Format: https://<domain>/<version>
VITE_API_BASE_URL=https://api.example.com/v1

# API Request Timeout (milliseconds)
# Range: 5000-30000
VITE_API_TIMEOUT=30000

# OAuth - Google Authentication
# Format: <project_id>-<hash>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=123456789-abcdef0123456789abcdef0123456789.apps.googleusercontent.com
# Format: https://<domain>/auth/google/callback
VITE_GOOGLE_REDIRECT_URI=https://app.example.com/auth/google/callback

# OAuth - Microsoft Authentication
# Format: GUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_MICROSOFT_CLIENT_ID=12345678-90ab-cdef-1234-567890abcdef
# Format: https://<domain>/auth/microsoft/callback
VITE_MICROSOFT_REDIRECT_URI=https://app.example.com/auth/microsoft/callback

# Application Configuration
# Format: alphanumeric with spaces
VITE_APP_NAME=Sales & Intelligence Platform
# Format: semver (x.y.z)
VITE_APP_VERSION=1.0.0
# Values: development|staging|production
VITE_ENVIRONMENT=development

# Security Configuration
# Format: boolean
VITE_ENABLE_MFA=true
# Range: 300-3600 (seconds)
VITE_SESSION_TIMEOUT=1800

# API Feature Flags
# Format: boolean
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MARKET_INTELLIGENCE=true
VITE_ENABLE_LEAD_SCORING=true

# Monitoring Configuration
# Range: 1000-10000 (milliseconds)
VITE_HEALTH_CHECK_INTERVAL=5000
# Format: boolean
VITE_ENABLE_ERROR_REPORTING=true

# Integration Timeouts (milliseconds)
# Range: 5000-60000
VITE_CRM_TIMEOUT=30000
VITE_EMAIL_TIMEOUT=20000
VITE_SOCIAL_TIMEOUT=15000

# Cache Configuration
# Range: 60-3600 (seconds)
VITE_CACHE_DURATION=300
# Format: boolean
VITE_ENABLE_OFFLINE_MODE=true